version: "3.8"

services:
  mysql:
    image: mysql:8.0
    container_name: shared-mysql
    restart: always
    ports:
      - "3306:3306"
    environment:
      MYSQL_ROOT_PASSWORD: "Password"
      MYSQL_DATABASE: "db"
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - web-network

volumes:
  mysql_data:

networks:
  web-network:
    external: true
